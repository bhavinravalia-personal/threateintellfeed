# Backend config
PORT=4000
FETCH_INTERVAL_SECONDS=300

# ===== VULNERABILITY INTELLIGENCE SOURCES (5) =====

# 1. NVD (National Vulnerability Database)
# https://services.nvd.nist.gov/rest/json/cves/2.0
# Free - No API key required (optional for higher rate limits)
NVD_API_KEY=optional_nvd_key

# 2. CISA KEV (Known Exploited Vulnerabilities)
# GitHub mirror: https://raw.githubusercontent.com/cisagov/kev-data/main/known_exploited_vulnerabilities.json
# Free - No API key needed

# 3. CIRCL cve-search (Aggregated CVE data)
# https://cve.circl.lu/api/
# Free - No API key needed

# 4. AlienVault OTX (Community threat intelligence)
# https://otx.alienvault.com/api/v1/
# Free API key required - Get from: https://otx.alienvault.com/auth/signin
OTX_API_KEY=your_otx_api_key

# ===== IOC ENRICHMENT & MALWARE/PHISHING FEEDS (5) =====

# 6. URLhaus (Malicious URLs database)
# https://urlhaus.abuse.ch/feeds/json_recent_100/
# Free - No API key needed

# 7. MalwareBazaar (Malware hashes & families)
# https://mb-api.abuse.ch/api/v1/
# Free - No API key needed

# 8. OpenPhish (Phishing URLs feed)
# https://openphish.com/feed.txt
# Free - No API key needed

# 9. urlscan.io (URL scanning intelligence)
# https://urlscan.io/api/v1/
# Free - No API key needed (optional API key for more features)

# 10. AbuseIPDB (Malicious IP addresses)
# https://api.abuseipdb.com/api/v2/
# Free API key required - Get from: https://www.abuseipdb.com/register?plan=free
ABUSEIPDB_API_KEY=your_abuseipdb_api_key

